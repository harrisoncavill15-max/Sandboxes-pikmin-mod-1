// ------------------------------
// RED PIKMIN
// ------------------------------
export const pikmin_red = {
    id: "pikmin_red",
    name: "Red Pikmin",
    type: "entity",
    sprite: "pikmin_red.png",
    health: 30,
    speed: 1.2,
    size: { x: 0.4, y: 0.6 },

    update(entity, world) {
        const players = world.getPlayers();
        const enemies = world.getEntities().filter(e => e.isEnemy);

        // Carrying
        handleCarrying(entity, world);

        // Thrown
        if (entity.isThrown) {
            entity.throwTimer--;
            for (const enemy of enemies) {
                if (entity.distanceTo(enemy) < 0.8) {
                    enemy.damage(6);
                    entity.isThrown = false;
                }
            }
            if (entity.throwTimer <= 0) entity.isThrown = false;
            return;
        }

        // Follow player
        let nearestPlayer = null;
        let nearestDist = Infinity;
        for (const p of players) {
            const d = entity.distanceTo(p);
            if (d < nearestDist) {
                nearestDist = d;
                nearestPlayer = p;
            }
        }
        if (nearestPlayer) entity.moveToward(nearestPlayer, this.speed);

        // Attack
        for (const enemy of enemies) {
            if (entity.distanceTo(enemy) < 1.0) enemy.damage(5);
        }
    }
};

