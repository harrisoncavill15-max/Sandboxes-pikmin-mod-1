// ------------------------------
// GLOBAL SETTINGS
// ------------------------------
const THROW_FORCE = 0.35;
const CARRY_DISTANCE = 0.8;
const CARRY_SPEED = 0.03;

// ------------------------------
// GLOBAL: Find nearest Pikmin
// ------------------------------
function getNearestPikmin(world, player) {
    const pikmin = world.getEntities().filter(e => e.id.startsWith("pikmin_"));
    let nearest = null;
    let dist = Infinity;

    for (const p of pikmin) {
        const d = p.distanceTo(player);
        if (d < dist) {
            dist = d;
            nearest = p;
        }
    }
    return nearest;
}

// ------------------------------
// GLOBAL: Throw Pikmin (Key T)
// ------------------------------
export function onKeyPress(world, key) {
    if (key !== "T") return;

    const player = world.getPlayers()[0];
    if (!player) return;

    const pikmin = getNearestPikmin(world, player);
    if (!pikmin) return;

    const cursor = world.getCursorPosition();
    const dir = {
        x: cursor.x - pikmin.position.x,
        y: cursor.y - pikmin.position.y
    };

    const len = Math.sqrt(dir.x * dir.x + dir.y * dir.y);
    dir.x /= len;
    dir.y /= len;

    pikmin.velocity.x += dir.x * THROW_FORCE;
    pikmin.velocity.y += dir.y * THROW_FORCE;

    pikmin.isThrown = true;
    pikmin.throwTimer = 20;
}

// ------------------------------
// GLOBAL: Carrying Objects
// ------------------------------
function handleCarrying(entity, world) {
    if (!entity.carryTarget) return;

    const target = entity.carryTarget;

    // Move Pikmin toward object
    const dx = target.position.x - entity.position.x;
    const dy = target.position.y - entity.position.y;
    const dist = Math.sqrt(dx * dx + dy * dy);

    if (dist > CARRY_DISTANCE) {
        entity.velocity.x += dx * CARRY_SPEED;
        entity.velocity.y += dy * CARRY_SPEED;
    } else {
        // Pikmin lifts object
        target.position.x = entity.position.x;
        target.position.y = entity.position.y - 0.5;

        // Move object toward Onion
        const onion = world.getEntities().find(e => e.id === "pikmin_onion");
        if (onion) {
            const odx = onion.position.x - target.position.x;
            const ody = onion.position.y - target.position.y;
            target.velocity.x += odx * 0.02;
            target.velocity.y += ody * 0.02;

            // Delivered!
            if (target.distanceTo(onion) < 1.0) {
                onion.pellets = (onion.pellets || 0) + 1;
                world.removeEntity(target);
                entity.carryTarget = null;
            }
        }
    }
}

