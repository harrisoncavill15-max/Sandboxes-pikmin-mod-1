// =====================================================
// ONION BASE (Grows Pikmin)
// =====================================================
export const pikmin_onion = {
    id: "pikmin_onion",
    name: "Pikmin Onion",
    type: "entity",
    sprite: "pikmin_onion.png",
    size: { x: 1.2, y: 1.2 },
    pellets: 0,

    update(entity, world) {
        // Grow Pikmin every 3 pellets
        if (entity.pellets >= 3) {
            entity.pellets -= 3;

            const newPikmin = world.spawnEntity("pikmin_red", {
                x: entity.position.x + (Math.random() - 0.5),
                y: entity.position.y - 1
            });

            newPikmin.velocity.y -= 0.3;
        }
    }
};

// =====================================================
// BOSS ENEMY
// =====================================================
export const pikmin_boss = {
    id: "pikmin_boss",
    name: "Bulblax Boss",
    type: "entity",
    sprite: "pikmin_boss.png",
    health: 300,
    size: { x: 2.0, y: 1.5 },
    speed: 0.6,
    isEnemy: true,

    update(entity, world) {
        const pikmin = world.getEntities().filter(e => e.id.startsWith("pikmin_"));

        // Chase nearest Pikmin
        let nearest = null;
        let dist = Infinity;
        for (const p of pikmin) {
            const d = entity.distanceTo(p);
            if (d < dist) {
                dist = d;
                nearest = p;
            }
        }

        if (nearest) entity.moveToward(nearest, this.speed);

        // Damage Pikmin
        for (const p of pikmin) {
            if (entity.distanceTo(p) < 1.4) {
                p.damage(8);
            }
        }

        // Boss death explosion
        if (entity.health <= 0) {
            for (let i = 0; i < 5; i++) {
                world.spawnEntity("pikmin_red", {
                    x: entity.position.x + (Math.random() - 0.5),
                    y: entity.position.y - 1
                });
            }
            world.removeEntity(entity);
        }
    }
};

